<view class="banners" wx:if="{{banners.length}}">
  <swiper autoplay circular indicator-dots style="height:340rpx">
    <swiper-item wx:for="{{banners}}" wx:key="id">
      <image src="{{item.image}}" mode="aspectFill" style="width:100%;height:340rpx;border-radius:16rpx"/>
    </swiper-item>
  </swiper>
</view>

<view class="card" wx:if="{{plan}}" bindtap="goPlan">
  <view style="font-size:34rpx;font-weight:700">{{plan.name}}</view>
  <view style="color:#616161;margin-top:8rpx">{{plan.intro}}</view>
  <view wx:for="{{plan.tree.stages}}" wx:key="id" style="margin-top:16rpx">
    <view style="font-weight:600;color:#1565C0">{{item.name}} · {{item.theme}}</view>
    <view wx:for="{{item.weeks}}" wx:for-item="w" wx:key="id" style="display:inline-block;background:#eef4fb;color:#1565C0;border-radius:24rpx;padding:6rpx 20rpx;margin:8rpx 8rpx 0 0;font-size:24rpx">{{w.label}}（{{w.dayCount}}天）</view>
  </view>
  <button class="btn-primary" style="margin-top:24rpx">查看方案 ›</button>
</view>

<view class="card news" wx:if="{{news.length}}">
  <view class="card-title">健康资讯</view>
  <view wx:for="{{news}}" wx:key="id" class="news-item">
    <image wx:if="{{item.image}}" class="news-img" src="{{item.image}}" mode="aspectFill" lazy-load/>
    <view class="news-body">
      <view class="news-title">{{item.title}}</view>
      <view wx:if="{{item.url}}" class="news-link">查看详情 ›</view>
    </view>
  </view>
</view>

<view class="card" wx:else style="text-align:center;color:#999">暂无上线方案，请在后台配置</view>
