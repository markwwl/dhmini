/* 首页样式 */
.banners { margin: 24rpx; }

/* 健康资讯列表 */
.news-item { display: flex; align-items: center; padding: 16rpx 0; border-top: 1rpx solid #f0f0f0; }
.news-item:first-of-type { border-top: none; }
.news-img { width: 120rpx; height: 120rpx; border-radius: 12rpx; flex-shrink: 0; background: #f3f3f3; }
.news-body { flex: 1; margin-left: 20rpx; min-width: 0; }
.news-title { font-size: 28rpx; color: #222; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.news-link { margin-top: 10rpx; font-size: 24rpx; color: #1565C0; }
