<!-- ============================ 每日食谱（L2） ============================ -->
<view wx:if="{{day}}">
  <!-- 天选择器 -->
  <scroll-view scroll-x class="day-bar">
    <view class="day-track">
      <view wx:for="{{dayList}}" wx:key="*this" class="day-pill {{dayNo === item ? 'day-pill-active' : ''}}" data-d="{{item}}" bindtap="tapDay">
        <text class="day-num">{{item}}</text>
        <text class="day-label">第{{item}}天</text>
      </view>
    </view>
  </scroll-view>

  <!-- 营养食谱 -->
  <view class="section-head">
    <text class="section-title">营养食谱</text>
    <text class="section-more" bindtap="openIngredients">今日食材 ›</text>
  </view>

  <view class="meal" wx:for="{{day.meals}}" wx:key="mealType">
    <view class="meal-head">
      <view class="meal-tag meal-tag-{{item.mealType}}">
        <text class="meal-dot"></text>
        <text class="meal-name">{{item.mealName}}</text>
      </view>
      <view class="meal-check" data-meal="{{item.mealType}}" bindtap="checkinMeal">一键打卡</view>
    </view>

    <view class="dish" wx:for="{{item.slots}}" wx:for-item="slot" wx:key="slotId">
      <image class="dish-img" src="{{slot.image}}" mode="aspectFill" lazy-load data-id="{{slot.dishId}}" bindtap="goDish"/>
      <view class="dish-info">
        <view class="dish-name ellipsis">{{slot.dishName}}</view>
        <view class="dish-ing ellipsis">{{slot.ingredientsSummary}}</view>
        <view class="dish-ops">
          <text class="op" data-id="{{slot.dishId}}" bindtap="goDish">做法 ›</text>
          <text class="op" wx:if="{{slot.candidateGroupId}}" data-slotid="{{slot.slotId}}" bindtap="goReplace">更换 ›</text>
          <text wx:if="{{slot.checked}}" class="tag-checked">✓ 已打卡</text>
          <text wx:else class="op op-check" data-slotid="{{slot.slotId}}" bindtap="checkin">打卡</text>
        </view>
      </view>
    </view>
  </view>

  <view class="safe-bottom"></view>

  <!-- 右下角「方案解读」悬浮入口（需求 4.2） -->
  <view class="fab" bindtap="showPlanDetail">方案解读</view>

  <!-- 底部固定操作条 -->
  <view class="bottom-bar">
    <button class="bar-btn bar-btn-plain" bindtap="showPlanDetail">方案详情</button>
    <button class="bar-btn" bindtap="checkinAll">整日打卡</button>
  </view>

  <!-- 今日食材弹层（需求 4.2 右上角入口） -->
  <view wx:if="{{showIngredients}}" class="mask" bindtap="closeIngredients">
    <view class="detail-panel" catchtap="">
      <view class="detail-title">今日所需食材（{{ingredientList.length}}）</view>
      <scroll-view scroll-y style="max-height:60vh">
        <view wx:for="{{ingredientList}}" wx:key="*this" class="ing-row">{{item}}</view>
        <view wx:if="{{!ingredientList.length}}" class="empty-sm">暂无食材数据</view>
      </scroll-view>
    </view>
  </view>

  <!-- 方案详情浮层 -->
  <view wx:if="{{showDetail}}" class="mask" bindtap="closeDetail">
    <view class="detail-panel" catchtap="">
      <view class="detail-title">方案详情</view>
      <scroll-view scroll-y style="max-height:60vh"><text user-select>{{detailText}}</text></scroll-view>
    </view>
  </view>
</view>

<view wx:else class="empty">
  <view class="empty-icon">🍚</view>
  <view>加载中…</view>
</view>
