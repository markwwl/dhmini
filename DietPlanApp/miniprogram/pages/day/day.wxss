/* ============================ 每日食谱（L2）============================ */

/* ---------- 天选择器 ---------- */
.day-bar {
  background: #fff;
  padding: 20rpx 0;
  box-shadow: var(--sh-1);
  white-space: nowrap;
}
.day-track { display: inline-flex; padding: 0 var(--sp); }
.day-pill {
  flex: none;
  width: 104rpx;
  margin-right: 16rpx;
  padding: 16rpx 0;
  border-radius: var(--r-sm);
  background: #F2F6F2;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: all .2s;
}
.day-num { font-size: 34rpx; font-weight: 800; color: var(--c-text-2); line-height: 1.1; }
.day-label { font-size: 20rpx; color: var(--c-text-3); margin-top: 6rpx; }
.day-pill-active {
  background: var(--grad-primary);
  box-shadow: 0 8rpx 18rpx rgba(22, 163, 74, .28);
}
.day-pill-active .day-num,
.day-pill-active .day-label { color: #fff; }

/* ---------- 餐次卡片 ---------- */
.meal {
  background: var(--c-card);
  border-radius: var(--r-md);
  margin: 20rpx var(--sp);
  padding: 24rpx;
  box-shadow: var(--sh-1);
}
.meal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.meal-tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: var(--r-pill);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.2;
}
.meal-dot { width: 12rpx; height: 12rpx; border-radius: 50%; margin-right: 12rpx; }
.meal-name { font-size: 26rpx; font-weight: 700; }
/* 早餐 / 午餐 / 晚餐 三色区分 */
.meal-tag-1 { background: var(--c-accent-50); color: var(--c-accent-600); }
.meal-tag-1 .meal-dot { background: var(--c-accent); }
.meal-tag-2 { background: var(--c-success-50); color: var(--c-success); }
.meal-tag-2 .meal-dot { background: var(--c-success); }
.meal-tag-3 { background: var(--c-info-50); color: var(--c-info); }
.meal-tag-3 .meal-dot { background: var(--c-info); }

.meal-check {
  font-size: 24rpx;
  color: var(--c-primary-600);
  font-weight: 600;
  padding: 8rpx 20rpx;
  border-radius: var(--r-pill);
  background: var(--c-primary-50);
}
.meal-check:active { opacity: .7; }

/* ---------- 菜品行 ---------- */
.dish { display: flex; padding: 20rpx 0; }
.dish + .dish { border-top: 1rpx solid var(--c-line); }
.dish-img {
  width: 160rpx; height: 160rpx;
  border-radius: var(--r-sm);
  background: #E7EFE8;
  flex: none;
}
.dish-info {
  flex: 1; min-width: 0;
  margin-left: 22rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.dish-name { font-size: 29rpx; font-weight: 700; color: var(--c-text); }
.dish-ing { color: var(--c-text-3); font-size: 24rpx; margin-top: 8rpx; }

.dish-ops {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}
.op {
  color: var(--c-primary);
  font-size: 24rpx;
  margin-right: 28rpx;
}
.op:active { opacity: .6; }
.op-check {
  color: #fff;
  background: var(--grad-primary);
  padding: 6rpx 22rpx;
  border-radius: var(--r-pill);
  margin-right: 0;
  font-weight: 600;
}
.tag-checked {
  background: var(--c-primary-100);
  color: var(--c-primary-600);
  border-radius: var(--r-pill);
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  font-weight: 600;
}

/* ---------- 悬浮入口 ---------- */
.fab {
  position: fixed;
  right: 28rpx;
  bottom: calc(160rpx + env(safe-area-inset-bottom));
  background: #fff;
  color: var(--c-primary-600);
  font-size: 24rpx;
  font-weight: 600;
  padding: 16rpx 28rpx;
  border-radius: var(--r-pill);
  box-shadow: 0 8rpx 24rpx rgba(20, 60, 35, .14);
  border: 2rpx solid var(--c-primary-100);
  z-index: 9;
}
.fab:active { transform: scale(.96); }

/* ---------- 底部操作条 ---------- */
.bottom-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  display: flex;
  padding: 16rpx var(--sp) calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -6rpx 22rpx rgba(20, 60, 35, .07);
}
.bar-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--grad-primary);
  color: #fff;
  border-radius: var(--r-pill);
  font-size: 29rpx;
  font-weight: 600;
  box-shadow: var(--sh-primary);
}
.bar-btn::after { border: none; }
.bar-btn-plain {
  background: #fff;
  color: var(--c-primary-600);
  border: 2rpx solid var(--c-primary-300);
  box-shadow: none;
  margin-right: 20rpx;
}

/* ---------- 弹层 ---------- */
.mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(10, 26, 16, .45);
  z-index: 10;
}
.detail-panel {
  position: absolute;
  left: 40rpx; right: 40rpx; top: 20vh;
  background: #fff;
  border-radius: var(--r-lg);
  padding: 32rpx;
  max-height: 66vh;
  box-shadow: var(--sh-2);
}
.detail-title {
  font-size: 32rpx;
  font-weight: 800;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}
.detail-title::before {
  content: '';
  width: 8rpx; height: 28rpx;
  border-radius: 4rpx;
  background: var(--grad-primary);
  margin-right: 14rpx;
}
.ing-row {
  padding: 18rpx 4rpx;
  border-bottom: 1rpx solid var(--c-line);
  font-size: 28rpx;
}
.empty-sm { color: var(--c-text-3); font-size: 24rpx; text-align: center; padding: 40rpx 0; }
