.day-bar { white-space: nowrap; background: #fff; padding: 20rpx 16rpx; }
.day-pill { display: inline-block; width: 110rpx; text-align: center; padding: 12rpx 0; border-radius: 16rpx; margin: 0 8rpx; background: #f0f2f5; font-size: 30rpx; font-weight: 600; }
.day-pill-active { background: #1565C0; color: #fff; }
.day-label { font-size: 20rpx; font-weight: 400; margin-top: 4rpx; }
.section-head { margin: 28rpx 24rpx 4rpx; display: flex; justify-content: space-between; align-items: baseline; }
.section-title { font-size: 32rpx; font-weight: 700; }
.section-more { color: #1565C0; font-size: 24rpx; }
.fab { position: fixed; right: 28rpx; bottom: calc(140rpx + env(safe-area-inset-bottom)); background: #1565C0; color: #fff; font-size: 24rpx; padding: 16rpx 26rpx; border-radius: 40rpx; box-shadow: 0 6rpx 18rpx rgba(21,101,192,.35); z-index: 9; }
.ing-row { padding: 16rpx 4rpx; border-bottom: 1rpx solid #f0f0f0; font-size: 28rpx; }
.meal { background: #fff; border-radius: 16rpx; margin: 16rpx 24rpx; padding: 20rpx; }
.meal-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.meal-name { font-size: 30rpx; font-weight: 700; }
.meal-check { color: #1565C0; font-size: 24rpx; }
.dish { display: flex; padding: 16rpx 0; border-top: 1rpx solid #f0f0f0; }
.dish-img { width: 160rpx; height: 160rpx; border-radius: 12rpx; background: #f0f2f5; flex-shrink: 0; }
.dish-info { flex: 1; margin-left: 20rpx; }
.dish-name { font-weight: 600; }
.dish-ing { color: #757575; font-size: 24rpx; margin-top: 6rpx; }
.dish-ops { margin-top: 14rpx; display: flex; align-items: center; gap: 24rpx; flex-wrap: wrap; }
.op { color: #1565C0; font-size: 24rpx; }
.op-check { color: #2e7d32; }
.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; background: #fff; display: flex; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); gap: 20rpx; box-shadow: 0 -4rpx 16rpx rgba(0,0,0,.05); }
.bar-btn { flex: 1; background: #1565C0; color: #fff; border-radius: 40rpx; font-size: 28rpx; }
.bar-btn-plain { background: #fff; color: #1565C0; border: 1rpx solid #1565C0; }
.mask { position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 10; }
.detail-panel { position: absolute; left: 40rpx; right: 40rpx; top: 20vh; background: #fff; border-radius: 20rpx; padding: 32rpx; }
.detail-title { font-weight: 700; font-size: 32rpx; margin-bottom: 20rpx; }
.empty { text-align: center; color: #999; padding-top: 200rpx; }
