/* ============================ 视频秀 ============================ */

.vhead { padding: 32rpx var(--sp) 4rpx; }
.vhead-title { font-size: 44rpx; font-weight: 800; letter-spacing: 1rpx; }
.vhead-sub { color: var(--c-text-3); font-size: 24rpx; margin-top: 8rpx; }

/* ---------- 视频卡 ---------- */
.vcard {
  background: var(--c-card);
  border-radius: var(--r-lg);
  margin: 24rpx var(--sp);
  overflow: hidden;
  box-shadow: var(--sh-1);
}
.vcard:active { transform: scale(.99); }

.vcover-box { position: relative; width: 100%; height: 380rpx; }
.vcover { width: 100%; height: 380rpx; background: #E7EFE8; }
/* 底部渐变，压住封面下沿 */
.vcover-box::after {
  content: '';
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 120rpx;
  background: linear-gradient(to top, rgba(6, 26, 14, .45), rgba(6, 26, 14, 0));
}

/* 中央播放按钮 */
.play-btn {
  position: absolute;
  left: 50%; top: 50%;
  width: 104rpx; height: 104rpx;
  margin: -52rpx 0 0 -52rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, .92);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, .18);
}
.play-tri {
  width: 0; height: 0;
  margin-left: 8rpx;
  border-top: 18rpx solid transparent;
  border-bottom: 18rpx solid transparent;
  border-left: 28rpx solid var(--c-primary);
}

.vbody {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
}
.vtitle { flex: 1; min-width: 0; font-size: 30rpx; font-weight: 700; line-height: 1.4; }
.vgo {
  flex: none;
  margin-left: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--c-primary);
}
