.profile { display: flex; align-items: center; background: #1565C0; padding: 48rpx 32rpx; color: #fff; }
.avatar-btn { margin: 0; padding: 0; background: transparent; line-height: 1; }
.avatar-btn::after { border: none; }
.avatar { width: 100rpx; height: 100rpx; border-radius: 50%; background: rgba(255,255,255,.25); text-align: center; line-height: 100rpx; font-size: 44rpx; }
.avatar-text { color: #1565C0; background: #fff; }
.profile-info { margin-left: 24rpx; flex: 1; }
.nick { font-size: 34rpx; font-weight: 700; color: #fff; min-height: 48rpx; }
.sub { font-size: 22rpx; opacity: .8; margin-top: 6rpx; }
.stats { display: flex; background: #fff; border-radius: 16rpx; margin: 16rpx 24rpx; padding: 28rpx 0; }
.stat { flex: 1; text-align: center; }
.num { font-size: 44rpx; font-weight: 700; color: #1565C0; }
.lbl { color: #757575; font-size: 22rpx; margin-top: 6rpx; }
.card { background: #fff; border-radius: 16rpx; margin: 16rpx 24rpx; padding: 24rpx; }
.card-title { font-weight: 700; margin-bottom: 16rpx; }
.cal { display: flex; flex-wrap: wrap; gap: 12rpx; }
.cal-day { background: #f0f2f5; border-radius: 12rpx; padding: 10rpx 14rpx; text-align: center; }
.cal-date { font-size: 22rpx; color: #616161; }
.cal-count { font-size: 22rpx; color: #1565C0; font-weight: 700; }
.fav { display: flex; align-items: center; padding: 16rpx 0; border-top: 1rpx solid #f0f0f0; }
.fav-img { width: 96rpx; height: 96rpx; border-radius: 12rpx; background: #f0f2f5; flex-shrink: 0; }
.fav-info { flex: 1; margin-left: 20rpx; }
.fav-name { font-weight: 600; font-size: 28rpx; }
.fav-sub { color: #757575; font-size: 22rpx; margin-top: 4rpx; }
.fav-go { color: #1565C0; font-size: 24rpx; }
.empty-sm { color: #999; font-size: 24rpx; text-align: center; padding: 20rpx 0; }
