/* ============================ 更换菜品（L4）============================ */

/* ---------- 搜索栏 ---------- */
.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 20rpx var(--sp);
  box-shadow: var(--sh-1);
}
.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 24rpx;
  background: #F2F6F2;
  border-radius: var(--r-pill);
}
.search-icon { font-size: 26rpx; margin-right: 12rpx; opacity: .55; }
.search-input { flex: 1; font-size: 27rpx; color: var(--c-text); }
.search-btn {
  margin-left: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--c-primary-600);
  padding: 12rpx 8rpx;
}
.search-btn:active { opacity: .6; }

/* ---------- 说明条 ---------- */
.tip {
  margin: 20rpx var(--sp) 4rpx;
  padding: 16rpx 22rpx;
  background: var(--c-primary-50);
  color: var(--c-primary-600);
  font-size: 23rpx;
  line-height: 1.5;
  border-radius: var(--r-sm);
}

/* ---------- 候选卡 ---------- */
.cand {
  display: flex;
  align-items: center;
  background: var(--c-card);
  border-radius: var(--r-md);
  margin: 20rpx var(--sp);
  padding: 24rpx;
  border: 2rpx solid transparent;
  box-shadow: var(--sh-1);
  transition: all .2s;
}
.cand-active {
  border-color: var(--c-primary);
  background: #F6FCF8;
  box-shadow: 0 8rpx 22rpx rgba(22, 163, 74, .14);
}

/* 圆形单选（替代原 ● ○ 字符） */
.radio {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid #D6E3D9;
  background: #fff;
  margin-right: 20rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all .2s;
}
.radio-on {
  background: var(--grad-primary);
  border-color: transparent;
  box-shadow: 0 4rpx 12rpx rgba(22, 163, 74, .32);
}
.radio-tick { color: #fff; font-size: 24rpx; font-weight: 700; line-height: 1; }

.cand-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--r-sm);
  background: #E7EFE8;
  flex: none;
}
.cand-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}
.cand-name { display: flex; align-items: center; }
.cand-name-txt { font-size: 29rpx; font-weight: 700; color: var(--c-text); }
.current-tag {
  flex: none;
  margin-left: 12rpx;
  background: var(--c-primary-100);
  color: var(--c-primary-600);
  font-size: 20rpx;
  line-height: 1;
  padding: 6rpx 14rpx;
  border-radius: var(--r-pill);
}
.cand-ing {
  color: var(--c-text-3);
  font-size: 24rpx;
  line-height: 1.45;
  margin: 10rpx 0;
}
.cand-link { color: var(--c-primary); font-size: 24rpx; font-weight: 500; }

/* ---------- 底部确认 ---------- */
.bottom-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  padding: 16rpx var(--sp) calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -6rpx 22rpx rgba(20, 60, 35, .07);
}
.confirm-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--grad-primary);
  color: #fff;
  border-radius: var(--r-pill);
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: var(--sh-primary);
}
.confirm-btn::after { border: none; }
